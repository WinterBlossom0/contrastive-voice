{
  "name": "contrastive-voice-launch-video",
  "version": "1.0.0",
  "description": "Launch video for Contrastive Voice",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "playwright-core": "^1.63.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "still": "remotion render LaunchVideo out/frames --image-format=png",
    "render": "remotion render LaunchVideo out/contrastive-voice-launch.mp4 --codec h264 --concurrency=8",
    "typecheck": "tsc --noEmit",
    "render:wsl": "PATH=\"$PWD/scripts/bin:$PATH\" remotion render LaunchVideo out/contrastive-voice-launch.mp4 --codec h264 --concurrency=8",
    "master": "ffmpeg -y -i out/contrastive-voice-launch.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11:linear=true -ar 48000 -c:a aac -b:a 192k out/contrastive-voice-launch-master.mp4",
    "capture": "node scripts/capture.cjs"
  }
}
